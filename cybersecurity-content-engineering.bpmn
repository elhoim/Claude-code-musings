<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="cybersecurity-content-engineering"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <process id="CybersecurityContentEngineering" name="Cybersecurity Content Engineering Process" isExecutable="false">

    <!-- Start Event -->
    <startEvent id="StartEvent_1" name="Content Request Received">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <!-- Task 1: Requirements Analysis -->
    <userTask id="Task_RequirementsAnalysis" name="Analyze Content Requirements">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </userTask>

    <!-- Task 2: Threat Intelligence Gathering -->
    <task id="Task_ThreatIntelligence" name="Gather Threat Intelligence">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <!-- Task 3: Research & Data Collection -->
    <task id="Task_Research" name="Research Security Topics">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <!-- Gateway: Content Type Decision -->
    <exclusiveGateway id="Gateway_ContentType" name="Content Type?">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5a</outgoing>
      <outgoing>Flow_5b</outgoing>
      <outgoing>Flow_5c</outgoing>
      <outgoing>Flow_5d</outgoing>
    </exclusiveGateway>

    <!-- Parallel Content Creation Tasks -->
    <task id="Task_CreateTutorial" name="Create Security Tutorial">
      <incoming>Flow_5a</incoming>
      <outgoing>Flow_6a</outgoing>
    </task>

    <task id="Task_CreateThreatAnalysis" name="Create Threat Analysis">
      <incoming>Flow_5b</incoming>
      <outgoing>Flow_6b</outgoing>
    </task>

    <task id="Task_CreateBestPractices" name="Create Best Practices Guide">
      <incoming>Flow_5c</incoming>
      <outgoing>Flow_6c</outgoing>
    </task>

    <task id="Task_CreateIncidentResponse" name="Create Incident Response Plan">
      <incoming>Flow_5d</incoming>
      <outgoing>Flow_6d</outgoing>
    </task>

    <!-- Merge Gateway -->
    <exclusiveGateway id="Gateway_Merge" name="Content Created">
      <incoming>Flow_6a</incoming>
      <incoming>Flow_6b</incoming>
      <incoming>Flow_6c</incoming>
      <incoming>Flow_6d</incoming>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>

    <!-- Task 4: Add Code Examples/Demonstrations -->
    <task id="Task_CodeExamples" name="Develop Code Examples &amp; Demonstrations">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
    </task>

    <!-- Task 5: Security Validation -->
    <task id="Task_SecurityValidation" name="Validate Security Claims">
      <incoming>Flow_8</incoming>
      <incoming>Flow_14</incoming>
      <outgoing>Flow_9</outgoing>
    </task>

    <!-- Gateway: Security Validation Check -->
    <exclusiveGateway id="Gateway_SecurityCheck" name="Security Validated?">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_13</outgoing>
    </exclusiveGateway>

    <!-- Task 6: Technical Review -->
    <task id="Task_TechnicalReview" name="Technical Peer Review">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
    </task>

    <!-- Gateway: Review Approval -->
    <exclusiveGateway id="Gateway_ReviewApproval" name="Review Approved?">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <outgoing>Flow_14</outgoing>
    </exclusiveGateway>

    <!-- Task 7: Compliance Check -->
    <task id="Task_ComplianceCheck" name="Compliance &amp; Legal Review">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_15</outgoing>
    </task>

    <!-- Gateway: Compliance Check -->
    <exclusiveGateway id="Gateway_ComplianceCheck" name="Compliant?">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <outgoing>Flow_17</outgoing>
    </exclusiveGateway>

    <!-- Task 8: Format and Style -->
    <task id="Task_Formatting" name="Format &amp; Style Content">
      <incoming>Flow_16</incoming>
      <outgoing>Flow_18</outgoing>
    </task>

    <!-- Task 9: Create Visuals -->
    <task id="Task_Visuals" name="Create Security Diagrams &amp; Visuals">
      <incoming>Flow_18</incoming>
      <outgoing>Flow_19</outgoing>
    </task>

    <!-- Task 10: Final Quality Check -->
    <task id="Task_QualityCheck" name="Final Quality Assurance">
      <incoming>Flow_19</incoming>
      <outgoing>Flow_20</outgoing>
    </task>

    <!-- Gateway: Quality Approved -->
    <exclusiveGateway id="Gateway_QualityCheck" name="Quality Approved?">
      <incoming>Flow_20</incoming>
      <outgoing>Flow_21</outgoing>
      <outgoing>Flow_22</outgoing>
    </exclusiveGateway>

    <!-- Task 11: Publication -->
    <task id="Task_Publication" name="Publish Content">
      <incoming>Flow_21</incoming>
      <outgoing>Flow_23</outgoing>
    </task>

    <!-- Task 12: Distribution -->
    <task id="Task_Distribution" name="Distribute to Channels">
      <incoming>Flow_23</incoming>
      <outgoing>Flow_24</outgoing>
    </task>

    <!-- Task 13: Monitor Feedback -->
    <task id="Task_Monitoring" name="Monitor Feedback &amp; Threats">
      <incoming>Flow_24</incoming>
      <outgoing>Flow_25</outgoing>
    </task>

    <!-- Gateway: Update Needed -->
    <exclusiveGateway id="Gateway_UpdateNeeded" name="Update Required?">
      <incoming>Flow_25</incoming>
      <outgoing>Flow_26</outgoing>
      <outgoing>Flow_27</outgoing>
    </exclusiveGateway>

    <!-- Task 14: Update Content -->
    <task id="Task_UpdateContent" name="Update Content">
      <incoming>Flow_26</incoming>
      <outgoing>Flow_28</outgoing>
    </task>

    <!-- End Event -->
    <endEvent id="EndEvent_1" name="Content Lifecycle Complete">
      <incoming>Flow_27</incoming>
    </endEvent>

    <!-- End Event for Rejected Content -->
    <endEvent id="EndEvent_Rejected" name="Content Rejected">
      <incoming>Flow_13</incoming>
      <incoming>Flow_17</incoming>
      <incoming>Flow_22</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_RequirementsAnalysis"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_RequirementsAnalysis" targetRef="Task_ThreatIntelligence"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_ThreatIntelligence" targetRef="Task_Research"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_Research" targetRef="Gateway_ContentType"/>

    <!-- Content Type Branches -->
    <sequenceFlow id="Flow_5a" name="Tutorial" sourceRef="Gateway_ContentType" targetRef="Task_CreateTutorial"/>
    <sequenceFlow id="Flow_5b" name="Threat Analysis" sourceRef="Gateway_ContentType" targetRef="Task_CreateThreatAnalysis"/>
    <sequenceFlow id="Flow_5c" name="Best Practices" sourceRef="Gateway_ContentType" targetRef="Task_CreateBestPractices"/>
    <sequenceFlow id="Flow_5d" name="Incident Response" sourceRef="Gateway_ContentType" targetRef="Task_CreateIncidentResponse"/>

    <!-- Merge Flows -->
    <sequenceFlow id="Flow_6a" sourceRef="Task_CreateTutorial" targetRef="Gateway_Merge"/>
    <sequenceFlow id="Flow_6b" sourceRef="Task_CreateThreatAnalysis" targetRef="Gateway_Merge"/>
    <sequenceFlow id="Flow_6c" sourceRef="Task_CreateBestPractices" targetRef="Gateway_Merge"/>
    <sequenceFlow id="Flow_6d" sourceRef="Task_CreateIncidentResponse" targetRef="Gateway_Merge"/>

    <sequenceFlow id="Flow_7" sourceRef="Gateway_Merge" targetRef="Task_CodeExamples"/>
    <sequenceFlow id="Flow_8" sourceRef="Task_CodeExamples" targetRef="Task_SecurityValidation"/>
    <sequenceFlow id="Flow_9" sourceRef="Task_SecurityValidation" targetRef="Gateway_SecurityCheck"/>

    <!-- Security Check Branches -->
    <sequenceFlow id="Flow_10" name="Yes" sourceRef="Gateway_SecurityCheck" targetRef="Task_TechnicalReview"/>
    <sequenceFlow id="Flow_13" name="No" sourceRef="Gateway_SecurityCheck" targetRef="EndEvent_Rejected"/>

    <sequenceFlow id="Flow_11" sourceRef="Task_TechnicalReview" targetRef="Gateway_ReviewApproval"/>

    <!-- Review Approval Branches -->
    <sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_ReviewApproval" targetRef="Task_ComplianceCheck"/>
    <sequenceFlow id="Flow_14" name="No - Revise" sourceRef="Gateway_ReviewApproval" targetRef="Task_SecurityValidation"/>

    <sequenceFlow id="Flow_15" sourceRef="Task_ComplianceCheck" targetRef="Gateway_ComplianceCheck"/>

    <!-- Compliance Check Branches -->
    <sequenceFlow id="Flow_16" name="Yes" sourceRef="Gateway_ComplianceCheck" targetRef="Task_Formatting"/>
    <sequenceFlow id="Flow_17" name="No" sourceRef="Gateway_ComplianceCheck" targetRef="EndEvent_Rejected"/>

    <sequenceFlow id="Flow_18" sourceRef="Task_Formatting" targetRef="Task_Visuals"/>
    <sequenceFlow id="Flow_19" sourceRef="Task_Visuals" targetRef="Task_QualityCheck"/>
    <sequenceFlow id="Flow_20" sourceRef="Task_QualityCheck" targetRef="Gateway_QualityCheck"/>

    <!-- Quality Check Branches -->
    <sequenceFlow id="Flow_21" name="Yes" sourceRef="Gateway_QualityCheck" targetRef="Task_Publication"/>
    <sequenceFlow id="Flow_22" name="No" sourceRef="Gateway_QualityCheck" targetRef="EndEvent_Rejected"/>

    <sequenceFlow id="Flow_23" sourceRef="Task_Publication" targetRef="Task_Distribution"/>
    <sequenceFlow id="Flow_24" sourceRef="Task_Distribution" targetRef="Task_Monitoring"/>
    <sequenceFlow id="Flow_25" sourceRef="Task_Monitoring" targetRef="Gateway_UpdateNeeded"/>

    <!-- Update Decision Branches -->
    <sequenceFlow id="Flow_26" name="Yes" sourceRef="Gateway_UpdateNeeded" targetRef="Task_UpdateContent"/>
    <sequenceFlow id="Flow_27" name="No" sourceRef="Gateway_UpdateNeeded" targetRef="EndEvent_1"/>
    <sequenceFlow id="Flow_28" sourceRef="Task_UpdateContent" targetRef="Task_ThreatIntelligence"/>

  </process>

  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="CybersecurityContentEngineering">

      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="152" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="136" y="145" width="68" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Shapes -->
      <bpmndi:BPMNShape id="Task_RequirementsAnalysis_di" bpmnElement="Task_RequirementsAnalysis">
        <omgdc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ThreatIntelligence_di" bpmnElement="Task_ThreatIntelligence">
        <omgdc:Bounds x="400" y="80" width="100" height="80"/>
