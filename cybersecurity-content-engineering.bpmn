        <omgdi:waypoint x="290" y="340"/>
        <omgdi:waypoint x="290" y="300"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <omgdi:waypoint x="900" y="260"/>
        <omgdi:waypoint x="960" y="260"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <omgdi:waypoint x="1010" y="260"/>
        <omgdi:waypoint x="1080" y="260"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <omgdi:waypoint x="985" y="285"/>
        <omgdi:waypoint x="985" y="520"/>
        <omgdi:waypoint x="443" y="520"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <omgdi:waypoint x="1130" y="300"/>
        <omgdi:waypoint x="1130" y="400"/>
        <omgdi:waypoint x="340" y="400"/>
      </bpmndi:BPMNEdge>

