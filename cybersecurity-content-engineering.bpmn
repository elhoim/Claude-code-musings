        <omgdi:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="340" y="120"/>
        <omgdi:waypoint x="400" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="500" y="120"/>
        <omgdi:waypoint x="560" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="660" y="120"/>
        <omgdi:waypoint x="720" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5a_di" bpmnElement="Flow_5a">
        <omgdi:waypoint x="745" y="95"/>
        <omgdi:waypoint x="745" y="60"/>
        <omgdi:waypoint x="840" y="60"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5b_di" bpmnElement="Flow_5b">
        <omgdi:waypoint x="745" y="120"/>
        <omgdi:waypoint x="745" y="160"/>
        <omgdi:waypoint x="840" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5c_di" bpmnElement="Flow_5c">
        <omgdi:waypoint x="745" y="145"/>
        <omgdi:waypoint x="745" y="260"/>
        <omgdi:waypoint x="840" y="260"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5d_di" bpmnElement="Flow_5d">
        <omgdi:waypoint x="770" y="120"/>
        <omgdi:waypoint x="805" y="120"/>
        <omgdi:waypoint x="805" y="360"/>
        <omgdi:waypoint x="840" y="360"/>
      </bpmndi:BPMNEdge>

