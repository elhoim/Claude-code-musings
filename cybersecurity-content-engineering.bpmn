      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <omgdc:Bounds x="1020" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CodeExamples_di" bpmnElement="Task_CodeExamples">
        <omgdc:Bounds x="1140" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SecurityValidation_di" bpmnElement="Task_SecurityValidation">
        <omgdc:Bounds x="240" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_SecurityCheck_di" bpmnElement="Gateway_SecurityCheck" isMarkerVisible="true">
        <omgdc:Bounds x="400" y="235" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="394" y="205" width="62" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TechnicalReview_di" bpmnElement="Task_TechnicalReview">
        <omgdc:Bounds x="520" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ReviewApproval_di" bpmnElement="Gateway_ReviewApproval" isMarkerVisible="true">
        <omgdc:Bounds x="680" y="235" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="661" y="205" width="89" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ComplianceCheck_di" bpmnElement="Task_ComplianceCheck">
        <omgdc:Bounds x="800" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ComplianceCheck_di" bpmnElement="Gateway_ComplianceCheck" isMarkerVisible="true">
        <omgdc:Bounds x="960" y="235" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="958" y="205" width="55" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Formatting_di" bpmnElement="Task_Formatting">
        <omgdc:Bounds x="1080" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Visuals_di" bpmnElement="Task_Visuals">
        <omgdc:Bounds x="240" y="360" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_QualityCheck_di" bpmnElement="Task_QualityCheck">
        <omgdc:Bounds x="400" y="360" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_QualityCheck_di" bpmnElement="Gateway_QualityCheck" isMarkerVisible="true">
        <omgdc:Bounds x="560" y="375" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="559" y="345" width="52" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Publication_di" bpmnElement="Task_Publication">
        <omgdc:Bounds x="680" y="360" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Distribution_di" bpmnElement="Task_Distribution">
        <omgdc:Bounds x="840" y="360" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Monitoring_di" bpmnElement="Task_Monitoring">
        <omgdc:Bounds x="1000" y="360" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_UpdateNeeded_di" bpmnElement="Gateway_UpdateNeeded" isMarkerVisible="true">
        <omgdc:Bounds x="1160" y="375" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1160" y="345" width="50" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_UpdateContent_di" bpmnElement="Task_UpdateContent">
        <omgdc:Bounds x="1135" y="480" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="1282" y="382" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1271" y="425" width="58" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
