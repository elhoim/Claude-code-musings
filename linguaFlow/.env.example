# Database
DATABASE_URL=postgresql://linguaflow:linguaflow@localhost:5432/linguaflow
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI / LLM
ANTHROPIC_API_KEY=your-anthropic-api-key

# Services (local dev ports)
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
LESSON_SERVICE_PORT=3002
SRS_SERVICE_PORT=3003
GRAMMAR_SERVICE_PORT=3004
STORY_SERVICE_PORT=3005
PRACTICE_SERVICE_PORT=3006
AI_SERVICE_PORT=3007

# App
NODE_ENV=development
LOG_LEVEL=debug
